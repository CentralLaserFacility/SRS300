
#___________________________________________
#_______substitutions values set to pvs_____
record(calc, "$(P)$(R):C_IMAXmA"){
    field(DESC, "Convert IMAX to mA for display")
    field(INPA, "$(P)$(R):IMAX")
    field(CALC, "A*1000")
    field(EGU, "mA")
    field(PREC, "2")
    field(PINI, "YES")
}
record(ai, "$(P)$(R):VMAX"){
    field(DESC, "Maximum voltage for device")
    field(EGU, "V")
}
record(ai, "$(P)$(R):VMIN"){
    field(DESC, "Maximum voltage for device")
    field(EGU, "V")
}

record(ai, "$(P)$(R):IMAX"){
    field(DESC, "Maximum current for device")
    field(EGU, "A")
    field(PREC, "4")
}
record(ai, "$(P)$(R):IMIN"){
    field(DESC, "Minimum current for device")
    field(EGU, "A")
    field(PREC, "4")
}

#the minimum and maximum based on absolute value of limits
#(values still retain original sign pos/neg)
record(calc, "$(P)$(R):C_absVMIN"){
    field(DESC, "Minimum voltage (closest to 0)")
    field(INPA, "$(P)$(R):VMAX PP")
    field(INPB, "$(P)$(R):VMIN PP")
    field(CALC, "ABS(A)>ABS(B) ? B : A") #in negative versions vmin has larger abs value
    field(EGU, "V")
    field(FLNK, "$(P)$(R):C_absVMAX")
}
record(calc, "$(P)$(R):C_absVMAX"){
    field(DESC, "Minimum voltage (closest to 0)")
    field(INPA, "$(P)$(R):VMAX PP")
    field(INPB, "$(P)$(R):VMIN PP")
    field(CALC, "ABS(A)>ABS(B) ? A : B") #in negative versions vmin has larger abs value
    field(EGU, "V")
    field(FLNK, "$(P)$(R):C_minStepSize")
}

#the device needs approximately 1.45 seconds to stabilize voltage after setting before reading it again
#so the minimum interval between steps is set to 1.5 seconds to allow for this
#and the delay after setting voltage before reading back is set to 1.45 seconds
#so that it reads just after it has stabilised but before the next step is set
record(ai, "$(P)$(R):C_minInterval"){
    field(DESC, "Minimum interval between steps")
    field(VAL, "1.5") #1.5 second minimum to allow for voltage stabilizing and reading before setting new val
    field(EGU, "seconds")
    field(PINI, "YES")
}
record(ai, "$(P)$(R):C_vgetDelay"){
    field(DESC, "Delay before reading voltage")
    field(VAL, "1.45") #1.45 second minimum to allow for voltage stabilizing before reading
    field(EGU, "seconds")
    field(PINI, "YES")
}
record(ai, "$(P)$(R):C_Tolerance"){
    field(DESC, "Tolerance for ramping")
    field(PINI, "YES")
    #val set from substitutions on start
    field(EGU, "V")
}

#________default settings______________
#___________________________________
record(bo, "$(P)$(R):DefaultSettings"){
    field(DESC, "Reset settings to default")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RCL 0) $(PORT) $(A)")
    field(ZNAM, "Reset to default settings")
    field(ONAM, "Reset to default settings")
    field(FLNK, "$(P)$(R):defaultLIM")
}

record(ai, "$(P)$(R):defaultLIM"){
    #stores default limit values for use in checking polarity
    field(DESC, "Store default limit values")
    field(INP, "$(P)$(R):VLIMget")
    field(FLNK, "$(P)$(R):checkPolarity")
}

#___device polarity check on startup____
#______________________________________
record(calcout, "$(P)$(R):checkPolarity"){
    field(DESC, "Check device polarity on startup")
    field(VAL, "3") #dummy initial value to allow processing on startup
    field(INPA, "$(P)$(R):defaultLIM")
    field(CALC, "A<0 ? 1 : 0") #if limit is negative, device is negative polarity
    field(OOPT, "On Change")
    field(OUT, "$(P)$(R):polarity PP")
}

record(bi, "$(P)$(R):polarity"){
    field(DESC, "Device polarity")
    field(ZNAM, "+ve")
    field(ONAM, "-ve")
}
#_______________________________________________________
#_________set substitutions based on polarity___________

#checks whether polarity is positive or negative and calls appropriate sequence
record(calcout, "$(P)$(R):callSubstitutionsPOS")
{
    field(DESC, "Set substitutions based on polarity")
    field(VAL, "3")#ensure initial value is non-zero so can be processed on transition to zero
    field(INPA, "$(P)$(R):polarity")
    field(CALC, "A")
    field(OCAL, "1")
    field(OOPT, "Transition To Zero")
    field(OUT, "$(P)$(R):SRS$(MODEL)+:setSubstitutions.PROC")
    field(FLNK, "$(P)$(R):callSubstitutionsNEG")
}
record(calcout, "$(P)$(R):callSubstitutionsNEG")
{
    field(DESC, "Set substitutions based on polarity")
    field(INPA, "$(P)$(R):polarity")
    field(CALC, "A")
    field(OCAL, "1")
    field(OOPT, "Transition To Non-zero")
    field(OUT, "$(P)$(R):SRS$(MODEL)-:setSubstitutions.PROC")
}


#substitutions can't usually be changed dynamically so a sequence must be used
#to account for models with switchable polarity
#H/LOPR and DRVH/L are not able to be set directly from another pv in the pv itself
#so a sequence is used to set the values 

#this sequence will only be called on initialisation and when polarity is changed
record(seq, "$(P)$(R):SRS$(MODELNO)$(POLARITY):setSubstitutions"){
    field(DESC, "Set substitutions based on polarity")
    field(DO0, "$(VMAX)")
    field(LNK0, "$(P)$(R):VLIMset.HOPR")
    field(DO1, "$(VMAX)")
    field(LNK1, "$(P)$(R):VLIMset.DRVH")
    field(DO2, "$(VMIN)")
    field(LNK2, "$(P)$(R):VLIMset.LOPR")
    field(DO3, "$(VMIN)")
    field(LNK3, "$(P)$(R):VLIMset.DRVL PP")
    field(DO4, "$(VMAX)")
    field(LNK4, "$(P)$(R):VMAX PP")
    field(DO5, "$(VMIN)")
    field(LNK5, "$(P)$(R):VMIN PP")
    field(DO6, "$(IMAX)")
    field(LNK6, "$(P)$(R):IMAX PP")
    field(DO7, "$(IMIN)")
    field(LNK7, "$(P)$(R):IMIN PP")
    field(DO8, "$(VMAX)")
    field(LNK8, "$(P)$(R):VLIMget.HOPR")
    field(DO9, "$(VMAX)")
    field(LNK9, "$(P)$(R):VLIMget.DRVH")
    field(DOA, "$(VMIN)")
    field(LNKA, "$(P)$(R):VLIMget.LOPR")
    field(DOB, "$(VMIN)")
    field(LNKB, "$(P)$(R):VLIMget.DRVL")
    field(DOC, "$(IMAX)")
    field(LNKC, "$(P)$(R):ILIMget.HOPR")
    field(DOD, "$(IMAX)")
    field(LNKD, "$(P)$(R):ILIMget.DRVH")
    field(DOE, "$(IMIN)")
    field(LNKE, "$(P)$(R):ILIMget.LOPR")
    field(DOF, "$(IMIN)")
    field(LNKF, "$(P)$(R):ILIMget.DRVL PP")
    field(FLNK, "$(P)$(R):SRS$(MODELNO)$(POLARITY):setSubstitutions2")
    
}

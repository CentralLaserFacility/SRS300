record(waveform, "$(P)$(R)IDN"){
    field(DESC, "SCPI identification string")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getIDN(79) $(PORT) $(A)")
    field(PINI, "YES")
    field(FTVL, "CHAR")
    field(NELM, "80")
}

record(mbbiDirect, "$(P)$(R)getESR"){
    field(DESC, "get event status register")
    field(DTYP, "stream")
    field(INP, "@ps300.proto getD(*ESR) $(PORT) $(A)")
    field(SCAN, "2 second")
    field(FLNK, "$(P)$(R)getPON")
}

record(bo, "$(P)$(R)DefaultSettings"){
    field(DESC, "Reset settings to default")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RCL 0) $(PORT) $(A)")
    field(ZNAM, "Reset to default settings")
    field(ONAM, "Reset to default settings")
    field(FLNK, "$(P)$(R)defaultLIM")
    
}

#______________________________________________
#______________status readbacks_________________
record(fanout, "$(P)$(R)ReadbackPoll_"){
    field(DESC, "Head of readback chain")
    field(PINI, "YES")
    field(SCAN, ".1 second")
    field(LNK1, "$(P)$(R)getSTB")
    field(LNK2, "$(P)$(R)HVONstatus")
    field(LNK3, "$(P)$(R)ILIMstatus")
    field(LNK4, "$(P)$(R)ITRIPstatus")
    field(LNK5, "$(P)$(R)VTRIPstatus")
}

record(mbbiDirect, "$(P)$(R)getSTB"){
    field(DESC, "SCPI get status byte")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getD(*STB) $(PORT) $(A)")
    field(SIML, "$(P)$(R)SIM")
    field(SIOL, "$(P)$(R)SIM:STB")
}
record(bi, "$(P)$(R)HVONstatus"){
    field(DESC, "Is HV on?")
    field(INP,  "$(P)$(R)getSTB.B7 NPP MS")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

#_______________________________________________
#______________status LEDs______________________

record(calcout, "$(P)$(R)ILIMstatus"){
    field(DESC, "Is current limited?")
    field(INPA,  "$(P)$(R)getSTB.B3 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A == 1 ? 3 : 0") #3 in mbbi record represents current limit
    field(OUT, "$(P)$(R)TripStatus.B3")
}
record(calcout, "$(P)$(R)ITRIPstatus"){
    field(DESC, "Tripped on overcurrent?")
    field(INPA,  "$(P)$(R)getSTB.B2 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A") #2 in mbbi record represents current trip
    field(OUT, "$(P)$(R)TripStatus.B2")
}
record(calcout, "$(P)$(R)VTRIPstatus"){
    field(DESC, "Tripped on overvoltage?")
    field(INPA,  "$(P)$(R)getSTB.B1 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A") #1 in mbbi record represents voltage trip
    field(OUT, "$(P)$(R)TripStatus.B1")
}

record(mbbiDirect, "$(P)$(R)TripStatus"){
    field(DESC, "Overall trip status")
    #B1 = overvoltage trip
    #B2 = overcurrent trip
    #B3 = current limit active
    field(PINI, "YES")
}

record(bi, "$(P)$(R)HVSTABLEstatus"){
    field(DESC, "HV stable?")
    field(INP,  "$(P)$(R)getSTB.B0 NPP MS")
    field(ZNAM, "Unstable")
    field(ONAM, "Stable")
    field(FLNK, "$(P)$(R)StableMultiState")
}

record(calc, "$(P)$(R)StableMultiState")
{#while ramping, stability briefly becomes unstable
#to get more accurate LED it should check for if it's unstable twice in a row
    field(INPA, "$(P)$(R)StableMultiState")
    field(INPB, "$(P)$(R)HVSTABLEstatus")
    field(INPC, "$(P)$(R)VRAMPactive")
    field(CALC, "B==0 ? MIN(A+1,3): 1-C") 
    # if unstable, val will be whichever is smallest, A+1 or 3 (meaning it can only increase to maximum 3)
    #if stable it is set back to 1 (or 0 if ramping)
    #states: 1 = stable, 2 = warning, 3 = unstable
    #while ramping states will begin at 0 to allow for 1 extra second of instability which is expected
}

#___________________________________________________
#_______________get current_________________________

record(ai, "$(P)$(R)OutputIget"){
    field(DESC, "Output current readback")
    field(DTYP, "stream")
    field(SCAN, ".1 second")
    field(INP,  "@ps300.proto getF(IOUT) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(FLNK, "$(P)$(R)OutputImA")
}

record(calc, "$(P)$(R)OutputImA"){
    field(DESC, "Convert output current to mA for display")
    field(INPA, "$(P)$(R)OutputIget")
    field(CALC, "A*1000")
    field(EGU, "mA")
    field(PREC, "2")
}
#__________________________________________
#__________Voltage get and set_____________

record(ao, "$(P)$(R)HVset")
{#sets the device's high voltage, should only be set through the state machine's ramping process
    field(DESC, "Set output voltage")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto setting(VSET) $(PORT) $(A)")
    field(EGU,  "V")
}
record(seq, "$(P)$(R)voltageMonitor"){
    field(DESC, "Monitor voltage")
    field(PINI, "YES")
    field(SCAN, "1 second")
    field(LNK1, "$(P)$(R)OutputVget.PROC")
    field(LNK2, "$(P)$(R)HVSTABLEstatus.PROC")
}
record(ai, "$(P)$(R)OutputVget"){
    field(DESC, "Output voltage readback")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(VOUT) $(PORT) $(A)")
    field(EGU,  "V")
    field(FLNK, "$(P)$(R)absVoltage")
}
record(calc, "$(P)$(R)absVoltage"){
    field(DESC, "Absolute value of output voltage")
    field(INPA, "$(P)$(R)OutputVget")
    field(CALC, "ABS(A)")
    field(EGU, "V")
}

#________________________________________________________
#________________enable/disable HV output________________
record(bo, "$(P)$(R)HVenable")
{#Turn high voltage on/off
    field(DESC, "Enable output")
    field(DTYP, "stream")
    field(VAL, "0")
    field(OUT,  "@ps300.proto hvOffOn $(PORT) $(A)")
    field(ZNAM, "Turn Off")
    field(ONAM, "Turn On")
    field(FLNK, "$(P)$(R)HVenableSeq")
}
record(seq, "$(P)$(R)HVenableSeq"){
    field(DESC, "Sequence to dis/enable HV")
    field(DOL1, "$(P)$(R)C_absVMIN PP")
    field(LNK1, "$(P)$(R)HVset PP")
    field(DO2, "0")
    field(LNK2, "$(P)$(R)VRAMPactive PP")
    field(LNK3, "$(P)$(R)getSTB.PROC PP")
}

#______________________________________________________
#______________Start ramping process__________________

record(ai, "$(P)$(R)startVoltage"){
    field(DESC, "Voltage at start of ramp")
    field(EGU, "V")
    field(PINI, "YES")
}

record(seq, "$(P)$(R)StartCharge"){
    field(DESC, "Sequence to start HV charge")
    #get/set values for graphing
    field(DOL3, "$(P)$(R)OutputVget")
    field(LNK3, "$(P)$(R)startVoltage PP")
    field(LNK4, "$(P)$(R)YaxisMax.PROC PP")
    field(LNK5, "$(P)$(R)YaxisMin.PROC PP")
    field(DOL6, "$(P)$(R)YaxisMin")
    field(LNK6, "$(P)$(R)autoscaleControlMin PP")
    field(DOL7, "$(P)$(R)YaxisMax")
    field(LNK7, "$(P)$(R)autoscaleControlMax PP")
    #calculate ramp parameters
    field(LNK8, "$(P)$(R)VRAMPcalc PP")
}

#_________________end charge sequence_________________
record(seq, "$(P)$(R)endCharge"){
    field(DESC, "Sequence to end HV charge")
    field(DO1, "0")
    field(LNK1, "$(P)$(R)VRAMPactive PP")
    field(DO2, "6")#DO field only takes double, 6 represents 1 second scan
    field(LNK2, "$(P)$(R)voltageMonitor.SCAN")
    field(LNK5, "$(P)$(R)idleZoom PP")
}

record(bi, "$(P)$(R)VRAMPactive")
{#when set to 1 ("Ramping") the state machine will begin the ramping process
    field(DESC, "Is charge active?")
    field(ZNAM, "Idle")
    field(ONAM, "Ramping")
    field(PINI, "YES")
}

record(aSub, "$(P)$(R)VRAMPcalc"){
    field(DESC, "Calculate ramp step size")
    field(SNAM, "rampcalc")
    #inputs
    field(INPA, "$(P)$(R)OutputVget")
    field(FTA, "DOUBLE")
    field(INPB, "$(P)$(R)desiredHV")
    field(FTB, "DOUBLE")
    field(INPC, "$(P)$(R)VRAMPtimeSet")
    field(FTC, "DOUBLE")
    field(INPD, "$(P)$(R)VRAMPstepSize")
    field(FTD, "DOUBLE")
    field(INPE, "$(P)$(R)VRAMPmode")
    field(FTE, "STRING")
    field(INPF, "$(P)$(R)VRAMPinterval")
    field(FTF, "DOUBLE")
    field(INPG, "$(P)$(R)C_minStepSize")
    field(FTG, "DOUBLE")
    field(INPH, "$(P)$(R)C_minInterval")
    field(FTH, "DOUBLE")
    field(INPI, "$(P)$(R)HVONstatus")
    field(FTI, "SHORT")
    #outputs
    field(OUTA, "$(P)$(R)VRAMPstepSize PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(P)$(R)VRAMPinterval PP")
    field(FTVB, "DOUBLE")
    field(OUTC, "$(P)$(R)VRAMPactive PP")
    field(FTVC, "SHORT")
    field(OUTD, "$(P)$(R)E_smallStep PP")
    field(FTVD, "SHORT")
    field(OUTE, "$(P)$(R)VRAMPtimeSet PP")
    field(FTVE, "DOUBLE")

}
#________________________________________________
#_________User set ramp parameters_______________

record(ai, "$(P)$(R)VRAMPtimeSet"){
    #LOPR and VAl passed in from setOnStart as cannot be set to a pv directly
    field(DESC, "Set desired ramp time")
    field(HOPR, "1000000")#HOPR must be set and setting to Inf is not supported by ui
    field(EGU,  "seconds")
    field(PINI, "YES")
}
record(ao, "$(P)$(R)VRAMPinterval") {
    #^^above comments apply
    field(DESC, "Set ramp up interval") 
    field(HOPR, "1000000")#HOPR must be set and setting to Inf is not supported by ui
    field(DRVH, "1000000")
    field(EGU, "seconds")
    field(PINI, "YES")
}

record(ao, "$(P)$(R)VRAMPstepSize"){
    field(DESC, "Set voltage ramp step size")
    field(EGU, "V")
    field(PINI, "YES")
}

record(bi, "$(P)$(R)VRAMPmode"){
    field(DESC, "Set ramp mode")
    field(PINI, "YES")
    field(VAL, "0") #Automatic mode by default
    #automatic means calculation is performed, manual means user sets step size and interval
    field(ZNAM, "Automatic")
    field(ONAM, "Manual")
}
record(ao, "$(P)$(R)desiredHV"){
    field(DESC, "Set target output voltage")
    field(EGU,  "V")
    field(PINI, "YES")
}

#____________________________________________
#________________constants___________________
record(calc, "$(P)$(R)C_minStepSize"){
    field(DESC, "Minimum step size for automatic ramping")
    field(INPA, "$(P)$(R)C_absVMIN")
    field(CALC, "ABS(A)") #the minimum step size is the absolute value of the minimum voltage
    field(EGU, "V") 
    field(FLNK, "$(P)$(R)C_maxStepSize")
}
record(calc, "$(P)$(R)C_maxStepSize"){
    field(DESC, "Maximum step size for automatic ramping")
    field(INPA, "$(P)$(R)C_absVMAX")
    field(CALC, "ABS(A)")
    field(EGU, "V")
}

#__________________________________________
#_____________error messages_______________

record(bo,"$(P)$(R)E_smallStep"){
    field(DESC, "Warning for step being too small")
    field(ZNAM, "Safe")
    field(ONAM, "Voltage change below min")
    field(OUT, "$(P)$(R)errorMessage PP")
    field(PINI, "YES")
}
#mbbi to hold error messages, to be updated with more error statuses if needed
record(mbbi, "$(P)$(R)errorMessage"){
    field(DESC, "Error message for ramping")
    field(PINI, "YES")
    field(ZRST, "No Error")
    field(ONST, "Voltage change below min")
}

#______________________________________________
#_______________Reset button__________________

record(seq, "$(P)$(R)hardReset"){
    field(DESC, "Hard reset sequence")
    field(DO1, "0")
    field(LNK1, "$(P)$(R)HVenable PP")
    field(LNK2, "$(P)$(R)TripClearSeq.PROC")
    field(FLNK, "$(P)$(R)ResetDevice")
}

record(bo, "$(P)$(R)ResetDevice"){
    field(DESC, "Reset device")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RST) $(PORT) $(A)")
    field(ZNAM, "Reset Device")
    field(ONAM, "Reset Device")
}

record(seq, "$(P)$(R)tripClearSeq"){
    field(DESC, "Sequence to clear trip and reset device")
    field(DO1, "0")
    field(LNK1, "$(P)$(R)TripStatus PP")
    field(LNK2, "$(P)$(R)TripClear.PROC PP")
    field(FLNK, "$(P)$(R)ReadbackPoll_")
}

record(bo, "$(P)$(R)TripClear"){
    field(DESC, "Clear a trip")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(TCLR) $(PORT) $(A)")
    field(ZNAM, "Clear")
    field(ONAM, "Clear")
    field(HIGH, "1")
    field(FLNK, "$(P)$(R)getSTB")
}

#_________________________________________________________
#____________Polarity and substitutions___________________

#when power on event detected, run sequence to check polarity and apply substitutions

record(calcout, "$(P)$(R)getPON"){
    field(DESC, "get power on event")
    field(INPA, "$(P)$(R)getESR.B7")#bit sever represents when device has been powered on
    field(CALC, "A")
    field(OCAL, "1")
    field(OUT, "$(P)$(R)PONseq.PROC")
    field(OOPT, "Transition To Non-zero")
}
record(seq, "$(P)$(R)PONseq"){
    #save current settings
    #reset to default settings
    #check polarity of default settings
    #restore saved settings
    #if polarity has changed, apply new substitutions
    field(DESC, "Power on event sequence")
    field(LNK0, "$(P)$(R)setSAV.PROC")
    field(LNK1, "$(P)$(R)DefaultSettings.PROC")
    field(DLY2, "0.5")
    field(LNK2, "$(P)$(R)RestoreSettings.PROC")
    field(LNK3, "$(P)$(R)callSubstitutionsPOS.PROC")
    #process sequence to apply substitutions based on model and polarity
    #in devSRS_PS3xx_sequences.template
    field(TPRO, "1")
    field(PINI, "YES")
}

record(bo, "$(P)$(R)DefaultSettings"){
    field(DESC, "Reset settings to default")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RCL 0) $(PORT) $(A)")
    field(ZNAM, "Reset to default settings")
    field(ONAM, "Reset to default settings")
    field(FLNK, "$(P)$(R)defaultLIM")
}

record(ai, "$(P)$(R)defaultLIM"){
    #stores default limit values for use in checking polarity
    field(DESC, "Store default limit values")
    field(INP, "$(P)$(R)VLIMget")
    field(FLNK, "$(P)$(R)checkPolarity")
}

record(calcout, "$(P)$(R)checkPolarity"){
    field(DESC, "Check device polarity on startup")
    field(VAL, "3") #dummy initial value to allow processing on startup
    field(INPA, "$(P)$(R)defaultLIM")
    field(CALC, "A<0 ? 1 : 0") #if limit is negative, device is negative polarity
    field(OOPT, "On Change")
    field(OUT, "$(P)$(R)polarity PP")
}

record(bi, "$(P)$(R)polarity"){
    field(DESC, "Device polarity")
    field(ZNAM, "+ve")
    field(ONAM, "-ve")
}
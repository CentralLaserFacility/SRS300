record(waveform, "$(DEVICE):IDN"){
    field(DESC, "SCPI identification string")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getIDN(79) $(PORT) $(A)")
    field(PINI, "YES")
    field(FTVL, "CHAR")
    field(NELM, "80")
}
#______________________________________________
#______________status readbacks_________________
record(fanout, "$(DEVICE):readbackPoll"){
    field(DESC, "Head of readback chain")
    field(PINI, "YES")
    field(SCAN, ".1 second")
    field(LNK1, "$(DEVICE):getSTB")
    field(LNK2, "$(DEVICE):HVONstatus")
    field(LNK3, "$(DEVICE):ILIMstatus")
    field(LNK4, "$(DEVICE):ITRIPstatus")
    field(LNK5, "$(DEVICE):VTRIPstatus")
}

record(mbbiDirect, "$(DEVICE):getSTB"){
    field(DESC, "SCPI get status byte")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getD(*STB) $(PORT) $(A)")
    field(SIML, "$(DEVICE):SIM")
    field(SIOL, "$(DEVICE):SIM:STB")
}
record(bi, "$(DEVICE):HVONstatus"){
    field(DESC, "Is HV on?")
    field(INP,  "$(DEVICE):getSTB.B7 NPP MS")
    field(ZNAM, "Off")
    field(ONAM, "On")
}

#_______________________________________________
#______________status LEDs______________________

record(calcout, "$(DEVICE):ILIMstatus"){
    field(DESC, "Is current limited?")
    field(INPA,  "$(DEVICE):getSTB.B3 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A == 1 ? 3 : 0") #3 in mbbi record represents current limit
    field(OUT, "$(DEVICE):tripStatus.B3")
}
record(calcout, "$(DEVICE):ITRIPstatus"){
    field(DESC, "Tripped on overcurrent?")
    field(INPA,  "$(DEVICE):getSTB.B2 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A") #2 in mbbi record represents current trip
    field(OUT, "$(DEVICE):tripStatus.B2")
}
record(calcout, "$(DEVICE):VTRIPstatus"){
    field(DESC, "Tripped on overvoltage?")
    field(INPA,  "$(DEVICE):getSTB.B1 NPP MS")
    field(OOPT, "Transition To Non-zero")
    field(CALC, "A") #1 in mbbi record represents voltage trip
    field(OUT, "$(DEVICE):tripStatus.B1")
}

#When tripped, the device sets the corresponding bit to 1
#however it resets it to 0 next time it is read even when still tripped
#therefore we use a mbbiDirect record to store the trip status bits which is only called on the bit's transition to 1
#this way the trip will be shown until it is cleared
record(mbbiDirect, "$(DEVICE):tripStatus"){
    field(DESC, "Overall trip status")
    #B1 = overvoltage trip
    #B2 = overcurrent trip
    #B3 = current limit active
    field(PINI, "YES")
}

record(bi, "$(DEVICE):voltageStable"){
    field(DESC, "HV stable?")
    field(INP,  "$(DEVICE):getSTB.B0 NPP MS")
    field(ZNAM, "Unstable")
    field(ONAM, "Stable")
    field(FLNK, "$(DEVICE):stableMultiState")
}

record(calc, "$(DEVICE):stableMultiState"){
#while ramping, stability briefly becomes unstable
#to get more accurate LED it should check for if it's unstable twice in a row
    field(INPA, "$(DEVICE):stableMultiState")
    field(INPB, "$(DEVICE):voltageStable")
    field(INPC, "$(DEVICE):rampActive")
    field(CALC, "B==0 ? MIN(A+1,3): 1-C") 
    # if unstable, val will be whichever is smallest, A+1 or 3 (meaning it can only increase to maximum 3)
    #if stable it is set back to 1 (or 0 if ramping)
    #states: 0 or 1 = stable, 2 = warning, 3 = unstable
    #while ramping states will begin at 0 to allow for 1 extra second of instability which is expected
}

#___________________________________________________
#_______________get current_________________________

record(ai, "$(DEVICE):OutputIget"){
    field(DESC, "Output current readback")
    field(DTYP, "stream")
    field(SCAN, ".1 second")
    field(INP,  "@ps300.proto getF(IOUT) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(FLNK, "$(DEVICE):outputCurrentmA")
}

record(calc, "$(DEVICE):outputCurrentmA"){
    field(DESC, "Convert output current to mA for display")
    field(INPA, "$(DEVICE):OutputIget")
    field(CALC, "A*1000")
    field(EGU, "mA")
    field(PREC, "2")
}
#__________________________________________
#__________Voltage get and set_____________

record(ao, "$(DEVICE):HVset"){
#sets the device's high voltage, should only be set through the state machine's ramping process
    field(DESC, "Set output voltage")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto setting(VSET) $(PORT) $(A)")
    field(EGU,  "V")
}
record(seq, "$(DEVICE):voltageMonitor"){
    field(DESC, "Monitor voltage")
    field(PINI, "YES")
    field(SCAN, "1 second")
    field(LNK1, "$(DEVICE):OutputVget.PROC")
    field(LNK2, "$(DEVICE):voltageStable.PROC")
}
record(ai, "$(DEVICE):OutputVget"){
    field(DESC, "Output voltage readback")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(VOUT) $(PORT) $(A)")
    field(EGU,  "V")
    field(FLNK, "$(DEVICE):absVoltage")
}
record(calc, "$(DEVICE):absVoltage"){
    field(DESC, "Absolute value of output voltage")
    field(INPA, "$(DEVICE):OutputVget")
    field(CALC, "ABS(A)")
    field(EGU, "V")
}

#________________________________________________________
#________________enable/disable HV output________________
record(bo, "$(DEVICE):enableHV"){
    #Turn high voltage on/off
    field(DESC, "Enable output")
    field(DTYP, "stream")
    field(VAL, "0")
    field(OUT,  "@ps300.proto hvOffOn $(PORT) $(A)")
    field(ZNAM, "Turn Off")
    field(ONAM, "Turn On")
    field(FLNK, "$(DEVICE):enableHVSeq")
    field(PINI, "YES")
}
record(seq, "$(DEVICE):enableHVSeq"){
    field(DESC, "Sequence to dis/enable HV")
    field(DOL1, "$(DEVICE):VMINabs PP")
    field(LNK1, "$(DEVICE):HVset PP")
    field(DO2, "0")
    field(LNK2, "$(DEVICE):rampActive PP")
    field(LNK3, "$(DEVICE):getSTB.PROC PP")
    field(DLY4, "1") #wait 1 second after enabling/disabling HV before checking status
    field(LNK4, "$(DEVICE):HVdisconnectError PP")
}
 record(calc, "$(DEVICE):HVdisconnectError"){
     field(DESC, "Check if device disconnected")
     field(INPA, "$(DEVICE):HVONstatus")
     field(INPB, "$(DEVICE):enableHV")
     field(CALC, "B == A ? 0 : 1") #1=disconnected/powered off, 0=normal
 }

#______________________________________________
#_______________Reset button__________________

record(seq, "$(DEVICE):hardReset"){
    field(DESC, "Hard reset sequence")
    field(DO1, "0")
    field(LNK1, "$(DEVICE):enableHV PP")
    field(LNK2, "$(DEVICE):tripClearSeq.PROC")
    field(FLNK, "$(DEVICE):resetDevice")
}

record(bo, "$(DEVICE):resetDevice"){
    field(DESC, "Reset device")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RST) $(PORT) $(A)")
}

record(seq, "$(DEVICE):tripClearSeq"){
    field(DESC, "Sequence to clear trip and reset device")
    #tripStatus is not set to 0 by device as the bit resets on read so is unreliable
    #tripClear command must be sent for tripStatus to be set to 0
    field(DO1, "0")
    field(LNK1, "$(DEVICE):tripStatus PP")
    field(LNK2, "$(DEVICE):tripClear.PROC PP")
    field(FLNK, "$(DEVICE):readbackPoll")
}

record(bo, "$(DEVICE):tripClear"){
    field(DESC, "Clear a trip")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(TCLR) $(PORT) $(A)")
    field(HIGH, "1")
    field(FLNK, "$(DEVICE):getSTB")
}

#_________________________________________________________
#____________Power on event___________________

#when power on event detected, run sequence to check polarity and apply substitutions

record(mbbiDirect, "$(DEVICE):getESR"){
    field(DESC, "get event status register")
    field(DTYP, "stream")
    field(INP, "@ps300.proto getD(*ESR) $(PORT) $(A)")
    field(SCAN, "2 second")
    field(FLNK, "$(DEVICE):getPON")
}

record(calcout, "$(DEVICE):getPON"){
    field(DESC, "get power on event")
    field(INPA, "$(DEVICE):getESR.B7")#bit seven represents when device has been powered on
    field(CALC, "A")
    field(OCAL, "1")
    field(OUT, "$(DEVICE):PONseq.PROC")
    field(OOPT, "Transition To Non-zero")
}
record(seq, "$(DEVICE):PONseq"){
    #save current settings then reset to default settings
    #check polarity of default settings
    #restore saved settings
    #if polarity has changed, apply new substitutions
    field(DESC, "Power on event sequence")
    field(LNK0, "$(DEVICE):SetSAV.PROC")
    field(LNK1, "$(DEVICE):DefaultSettings.PROC")
    field(DLY2, "0.5")
    field(LNK2, "$(DEVICE):RestoreSettings.PROC")
    field(LNK3, "$(DEVICE):CallSubstitutionsPOS.PROC")
    #process sequence to apply substitutions based on model and polarity
    #in devSRS_PS3xx_sequences.template
    field(PINI, "YES")
}

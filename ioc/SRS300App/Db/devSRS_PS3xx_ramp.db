#______________________________________________________
#______________Start ramping process__________________

record(ai, "$(DEVICE):StartVoltage"){
    field(DESC, "Voltage at start of ramp")
    field(EGU, "V")
    field(PINI, "YES")
}

record(seq, "$(DEVICE):StartCharge"){
    field(DESC, "Sequence to start HV charge")
    #get/set values for graphing
    field(DOL1, "$(DEVICE):OutputVget")
    field(LNK1, "$(DEVICE):StartVoltage PP")
    field(LNK2, "$(DEVICE):YaxisMax.PROC PP")
    field(LNK3, "$(DEVICE):YaxisMin.PROC PP")
    field(DOL4, "$(DEVICE):YaxisMin")
    field(LNK4, "$(DEVICE):AutoscaleControlMin PP")
    field(DOL5, "$(DEVICE):YaxisMax")
    field(LNK5, "$(DEVICE):AutoscaleControlMax PP")
    #calculate ramp parameters
    field(LNK6, "$(DEVICE):rampCalc PP")
}

#_________________end charge sequence_________________
record(seq, "$(DEVICE):endCharge"){
    field(DESC, "Sequence to end HV charge")
    field(DO1, "0")
    field(LNK1, "$(DEVICE):rampActive PP")
    field(LNK2, "$(DEVICE):idleZoom PP")
}

record(bi, "$(DEVICE):rampActive"){
#when set to 1 ("Ramping") the state machine will begin the ramping process
    field(DESC, "Is charge active?")
    field(ZNAM, "Idle")
    field(ONAM, "Ramping")
    field(PINI, "YES")
}

record(aSub, "$(DEVICE):rampCalc"){
    field(DESC, "Calculate ramp step size")
    field(SNAM, "rampcalc")
    #inputs
    field(INPA, "$(DEVICE):OutputVget")
    field(FTA, "DOUBLE")
    field(INPB, "$(DEVICE):TargetHV")
    field(FTB, "DOUBLE")
    field(INPC, "$(DEVICE):RampDuration")
    field(FTC, "DOUBLE")
    field(INPD, "$(DEVICE):RampStepSize")
    field(FTD, "DOUBLE")
    field(INPE, "$(DEVICE):rampMode")
    field(FTE, "STRING")
    field(INPF, "$(DEVICE):RampInterval")
    field(FTF, "DOUBLE")
    field(INPG, "$(DEVICE):MinStepSize")
    field(FTG, "DOUBLE")
    field(INPH, "$(DEVICE):MinInterval")
    field(FTH, "DOUBLE")
    field(INPI, "$(DEVICE):HVONstatus")
    field(FTI, "SHORT")
    #outputs
    field(OUTA, "$(DEVICE):RampStepSize PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(DEVICE):RampInterval PP")
    field(FTVB, "DOUBLE")
    field(OUTC, "$(DEVICE):rampActive PP")
    field(FTVC, "SHORT")
    field(OUTD, "$(DEVICE):smallStepError PP")
    field(FTVD, "SHORT")
    field(OUTE, "$(DEVICE):RampDuration PP")
    field(FTVE, "DOUBLE")

}
#________________________________________________
#_________User set ramp parameters_______________

record(ai, "$(DEVICE):RampDuration"){
    #LOPR and VAl passed in from SetOnStart as cannot be set to a pv directly
    field(DESC, "Set desired ramp time")
    field(HOPR, "1000000")#HOPR must be set and setting to Inf is not supported by ui
    field(EGU,  "seconds")
    field(PINI, "YES")
}
record(ao, "$(DEVICE):RampInterval") {
    #^^above comments apply
    field(DESC, "Set ramp up interval") 
    field(HOPR, "1000000")#HOPR must be set and setting to Inf is not supported by ui
    field(DRVH, "1000000")
    field(EGU, "seconds")
    field(PINI, "YES")
}

record(ao, "$(DEVICE):RampStepSize"){
    field(DESC, "Set voltage ramp step size")
    field(EGU, "V")
    field(PINI, "YES")
}

record(bi, "$(DEVICE):rampMode"){
    field(DESC, "Set ramp mode")
    field(PINI, "YES")
    field(VAL, "0") #Automatic mode by default
    #automatic means calculation is performed, manual means user sets step size and interval
    field(ZNAM, "Automatic")
    field(ONAM, "Manual")
}
record(ao, "$(DEVICE):TargetHV"){
    field(DESC, "Set target output voltage")
    field(EGU,  "V")
    field(PINI, "YES")
}

#____________________________________________
#________________constants___________________
record(calc, "$(DEVICE):MinStepSize"){
    field(DESC, "Minimum step size for automatic ramping")
    field(INPA, "$(DEVICE):VMINabs")
    field(CALC, "ABS(A)") #the minimum step size is the absolute value of the minimum voltage
    field(EGU, "V") 
    field(FLNK, "$(DEVICE):MaxStepSize")
}
record(calc, "$(DEVICE):MaxStepSize"){
    field(DESC, "Maximum step size for automatic ramping")
    field(INPA, "$(DEVICE):VMAXabs")
    field(CALC, "ABS(A)")
    field(EGU, "V")
}
#__________________________________________
#_____________error messages_______________

record(calc, "$(DEVICE):smallStepError"){
    field(DESC, "warning for step being too small")
    field(INPA, "$(DEVICE):TargetHV PP")
    field(INPB, "$(DEVICE):OutputVget")
    field(INPC, "$(DEVICE):MinStepSize")
    field(CALC, "ABS(A-B) < C ? 1 : 0") #1=error, 0=no error
    field(PINI, "YES")
}
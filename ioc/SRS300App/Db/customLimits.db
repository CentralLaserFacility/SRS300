#_________________________________________________________
#_____________get and set limits to device______________

record(ao, "$(P)$(R)VLIMset")
{
    field(DESC, "Set output voltage limit")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto setting(VLIM) $(PORT) $(A)")
    field(EGU,  "V")
    field(FLNK, "$(P)$(R)VLIMget")
}
record(ai, "$(P)$(R)VLIMget")
{
    field(DESC, "Get output voltage limit")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(VLIM) $(PORT) $(A)")
    field(EGU,  "V")
    field(PINI, "YES")

}
record(ao, "$(P)$(R)ILIMset")
{
    field(DESC, "Set output current limit")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto setting(ILIM) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(FLNK, "$(P)$(R)ILIMget")
}
record(ai, "$(P)$(R)ILIMget")
{
    field(DESC, "Get output current limit")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(ILIM) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(PINI, "YES")
    field(FLNK, "$(P)$(R)ILIMmA")
}

record(ao, "$(P)$(R)ITRPset")
{
    field(DESC, "Set output current trip limit")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto setting(ITRP) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(FLNK, "$(P)$(R)ITRPget")
}
record(ai, "$(P)$(R)ITRPget")
{
    field(DESC, "Get output current trip limit")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(ITRP) $(PORT) $(A)")
    field(EGU,  "A")
    field(PREC, "4")
    field(PINI, "YES")
    field(FLNK, "$(P)$(R)ITRPmA")
}
#_________________________________________________________
#___________save/restore limit settings_____________

record(bo, "$(P)$(R)setSAV")
{
    field(DESC, "Save current device settings")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*SAV 1) $(PORT) $(A)")
    field(ZNAM, "Set to save settings")
    field(ONAM, "Set to save settings")
    
}
record(bo, "$(P)$(R)RestoreSettings")
{
    field(DESC, "Restore saved settings")
    field(DTYP, "stream")
    field(OUT,  "@ps300.proto cmd(*RCL 1) $(PORT) $(A)")
    field(ZNAM, "Restore to saved settings")
    field(ONAM, "Restore saved settings1")
}
#_________________________________________________________
#when changes are applied from the limit menu, set the device limits to the new values

record(seq,"$(P)$(R)setNewLimitsPOS"){
    field(DESC, "sets limits from constants")
    field(DOL1, "$(P)$(R)voltageLimitSET PP")
    field(LNK1, "$(P)$(R)VLIMset PP")
    field(DOL2, "$(P)$(R)currentLimitA PP")
    field(LNK2, "$(P)$(R)ILIMset PP")
    field(DOL3, "$(P)$(R)currentTripLimitA PP")
    field(LNK3, "$(P)$(R)ITRPset PP")
    field(DOL4, "$(P)$(R)voltageLimitSET")
    field(LNK4, "$(P)$(R)desiredHV.HOPR")
    field(DOL5, "$(P)$(R)voltageLimitSET")
    field(LNK5, "$(P)$(R)HVset.HOPR")
    field(DOL6, "$(P)$(R)voltageLimitSET")
    field(LNK6, "$(P)$(R)HVset.DRVH PP")
    field(DOL7, "$(P)$(R)voltageLimitSET")
    field(LNK7, "$(P)$(R)OutputVget.HOPR PP")
    field(DOL8, "$(P)$(R)voltageLimitSET")
    field(LNK8, "$(P)$(R)desiredHV.DRVH PP")
}
record(seq,"$(P)$(R)setNewLimitsNEG"){
    field(DESC, "sets limits from constants")
    field(DOL1, "$(P)$(R)voltageLimitSET PP")
    field(LNK1, "$(P)$(R)VLIMset PP")
    field(DOL2, "$(P)$(R)currentLimitA PP")
    field(LNK2, "$(P)$(R)ILIMset PP")
    field(DOL3, "$(P)$(R)currentTripLimitA PP")
    field(LNK3, "$(P)$(R)ITRPset PP")
    field(DOL4, "$(P)$(R)voltageLimitSET")
    field(LNK4, "$(P)$(R)desiredHV.LOPR")
    field(DOL5, "$(P)$(R)voltageLimitSET")
    field(LNK5, "$(P)$(R)HVset.LOPR")
    field(DOL6, "$(P)$(R)voltageLimitSET")
    field(LNK6, "$(P)$(R)HVset.DRVL PP")
    field(DOL7, "$(P)$(R)voltageLimitSET")
    field(LNK7, "$(P)$(R)OutputVget.LOPR PP")
    field(DOL8, "$(P)$(R)voltageLimitSET")
    field(LNK8, "$(P)$(R)desiredHV.DRVL PP")
}
#_________________________________________________
#_________user changeable limit settings_________

record(ao, "$(P)$(R)currentLimitmA"){
    field(DESC, "Maximum current for device")
    field(PINI, "YES")
    #val and HOPR passed in from C_IMAXmA on start
    field(EGU, "mA")
    field(FLNK, "$(P)$(R)currentLimitA")
}
record(calc, "$(P)$(R)currentLimitA"){
    field(DESC, "Convert input to A for device")
    field(INPA, "$(P)$(R)currentLimitmA")
    field(CALC, "A/1000")
    field(EGU, "A")
    field(PREC, "4")
}

record(ao, "$(P)$(R)currentTripLimitmA"){
    #settable by user from ui
    field(DESC, "Maximum current trip limit for device")
    #val and HOPR passed in from C_IMAXmA on start
    field(EGU, "mA")
    field(PREC, "2")
    field(FLNK, "$(P)$(R)currentTripLimitA")
}
record(calc, "$(P)$(R)ILIMmA"){
    #holds converted value from device for display
    field(DESC, "Convert ILIM to mA for display")
    field(INPA, "$(P)$(R)ILIMget")
    field(CALC, "A*1000")
    field(EGU, "mA")
    field(PREC, "2")
}

record(calc, "$(P)$(R)ITRPmA")
{#holds converted value from device for display
    field(DESC, "Convert ITRP to mA for display")
    field(INPA, "$(P)$(R)ITRPget")
    field(CALC, "A*1000")
    field(EGU, "mA")
    field(PREC, "2")
}
record(calc, "$(P)$(R)currentTripLimitA"){
    field(DESC, "Convert input to A for device")
    field(INPA, "$(P)$(R)currentTripLimitmA")
    field(CALC, "A/1000")
    field(EGU, "A")
    field(PREC, "4")
}
record(ao, "$(P)$(R)voltageLimitSET"){
    field(DESC, "Maximum voltage for device")
    field(EGU, "V")
    field(PINI, "YES")
}
#If the menu is closed before changes are applied, limit values are changed back to what they were previously
record(seq, "$(P)$(R)limitMenuClosed"){
    field(DESC, "Sequence to run when limit menu closed")
    field(DOL1, "$(P)$(R)VLIMget PP")
    field(LNK1, "$(P)$(R)voltageLimitSET PP")
    field(DOL2, "$(P)$(R)ILIMmA")
    field(LNK2, "$(P)$(R)currentLimitmA PP")
    field(DOL3, "$(P)$(R)ITRPmA")
    field(LNK3, "$(P)$(R)currentTripLimitmA PP")
}

#If limits are reset to default from the menu, set device limits to default values
record(seq, "$(P)$(R)resetLimits"){
    field(DESC, "Reset limits to default from device")
    field(DOL1, "$(P)$(R)C_absVMAX PP")
    field(LNK1, "$(P)$(R)voltageLimitSET PP")
    field(DOL2, "$(P)$(R)C_IMAXmA")
    field(LNK2, "$(P)$(R)currentLimitmA PP")
    field(DOL3, "$(P)$(R)C_IMAXmA")
    field(LNK3, "$(P)$(R)currentTripLimitmA PP")
}
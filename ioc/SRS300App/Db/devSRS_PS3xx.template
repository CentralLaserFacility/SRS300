#______Start charge button______________
record(bi, "$(P)$(R)chargeStartHelper")
{
    field(DESC, "Helper record to start HV charge")
    field(FLNK, "$(P)$(R)StartCharge")
}
record(seq, "$(P)$(R)StartCharge")
{
    field(DESC, "Sequence to start HV charge")
    #rampcalc/mode stuff here
    field(DO1, "1")
    field(LNK1, "$(P)$(R)VRAMPcalc.PROC PP")
    field(TPRO, "1")

}
record(bi, "$(P)$(R)VRAMPactive")
{
    field(DESC, "Is charge active?")
    field(ZNAM, "Idle")
    field(ONAM, "charging")
    field(TPRO, "1")
}


#_________ramp parameters_______________


record(ai, "$(P)$(R)VRAMPtimeSet")
{
    field(DESC, "Set desired ramp time")
    field(EGU,  "s")
    field(PINI, "YES")
}
record(ai, "$(P)$(R)VRAMPinterval") {
    field(DESC, "Set ramp up interval")
    field(VAL, "1") #1 seconds
    field(EGU, "second")
    field(TPRO, "1")
}
record(ai, "$(P)$(R)VRAMPstepSize"){
    field(DESC, "Set voltage ramp step size")
    field(VAL, "100") #100 V per step
    field(LOPR, "100")
}

record(bi, "$(P)$(R)VRAMPmode"){
    field(DESC, "Set ramp mode")
    field(PINI, "YES")
    field(VAL, "0") #0=automatic, 1=manual
    field(ZNAM, "Automatic")
    field(ONAM, "Manual")
    field(TPRO, "1")

}

#__________ramp procedure_______________
#_______________________________________



#__________ramp calculation_______________
record(aSub, "$(P)$(R)VRAMPcalc"){
    field(DESC, "Calculate ramp step size")
    field(SNAM, "rampcalc")
    field(INPA, "$(P)$(R)OutputVget")
    field(FTA, "DOUBLE")
    field(INPB, "$(P)$(R)desiredHV")
    field(FTB, "DOUBLE")
    field(INPC, "$(P)$(R)VRAMPtimeSet")
    field(FTC, "DOUBLE")
    field(INPD, "$(P)$(R)VRAMPstepSize")
    field(FTD, "DOUBLE")
    field(INPE, "$(P)$(R)VRAMPmode")
    field(FTE, "SHORT")
    field(OUTA, "$(P)$(R)VRAMPstepSize PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(P)$(R)VRAMPinterval PP")
    field(FTVB, "DOUBLE")
    field(OUTC, "$(P)$(R)VRAMPactive PP")
    field(FTVC, "SHORT")
    field(TPRO, "1")

}
record(bo, "$(DEVICE):HVenable")
{#Turn high voltage on/off
    field(DESC, "Enable output")
    field(DTYP, "stream")
    field(VAL, "0")
    field(OUT,  "@ps300.proto hvOffOn $(PORT) $(A)")
    field(ZNAM, "Turn Off")
    field(ONAM, "Turn On")
    field(PINI, "YES")
    field(FLNK, "$(DEVICE):HVenableSeq")
}

record(seq, "$(DEVICE):HVenableSeq")
{
    field(DESC, "Sequence to dis/enable HV")
    field(DO1, "$(VMIN)")
    field(LNK1, "$(DEVICE):HVset PP")
    field(DO2, "0")
    field(LNK2, "$(DEVICE):VRAMPactive PP")
    field(LNK3, "$(DEVICE):getSTB.PROC PP")
}

#____________________________________________
#_________Start ramping process______________

record(bi, "$(DEVICE):chargeStartHelper")
{
    field(DESC, "Helper record to start HV charge")
    field(FLNK, "$(DEVICE):StartCharge")
}
record(seq, "$(DEVICE):StartCharge")
{
    field(DESC, "Sequence to start HV charge")
    #get/set values for graphing
    field(DOL3, "$(DEVICE):OutputVget")
    field(LNK3, "$(DEVICE):startVoltage PP")
    field(DO4, "1")
    field(LNK4, "$(DEVICE):YaxisMax.PROC PP")
    field(DO5, "1")
    field(LNK5, "$(DEVICE):YaxisMin.PROC PP")
    field(DOL6, "$(DEVICE):YaxisMin")
    field(LNK6, "$(DEVICE):autoscaleControlMin PP")
    field(DOL7, "$(DEVICE):YaxisMax")
    field(LNK7, "$(DEVICE):autoscaleControlMax PP")
    #calculate ramp parameters
    field(LNK8, "$(DEVICE):VRAMPcalc PP")
}

record(bi, "$(DEVICE):VRAMPactive")
{#when set to 1 ("Ramping") the state machine will begin the ramping process
    field(DESC, "Is charge active?")
    field(ZNAM, "Idle")
    field(ONAM, "Ramping")
    field(PINI, "YES")
}


#____________________________________________
#_________Start ramping process______________

record(bi, "$(P)$(R)chargeStartHelper")
{
    field(DESC, "Helper record to start HV charge")
    field(FLNK, "$(P)$(R)StartCharge")
}
record(seq, "$(P)$(R)StartCharge")
{
    field(DESC, "Sequence to start HV charge")
    #set scan to passive (0 as DO1 only takes doubles) 
    #so while ramping voltage is only checked after being set and not continuously
    field(DO1, "0")
    field(LNK1, "$(P)$(R)voltageMonitor.SCAN")
    #set delay to 1.45 seconds to allow for voltage to stabilize once set beore being checked again
    field(DOL2, "$(P)$(R)C_vgetDelay") 
    field(LNK2, "$(P)$(R)voltageMonitor.DLY1")
    #process ramp value calculation
    field(LNK3, "$(P)$(R)VRAMPcalc PP")
}

record(bi, "$(P)$(R)VRAMPactive")
{#when set to 1 ("Ramping") the state machine will begin the ramping process
    field(DESC, "Is charge active?")
    field(ZNAM, "Idle")
    field(ONAM, "Ramping")
}

#_____________________________________________
#______User set ramp parameters_______________

record(ai, "$(P)$(R)VRAMPtimeSet"){
    #LOPR and VAl passed in from setOnStart as cannot be set to a pv directly
    field(DESC, "Set desired ramp time")
    field(HOPR, "1000000")#HOPR must be set and setting to Inf is not supported by ui
    field(EGU,  "seconds")
    field(PINI, "YES")
}
record(ai, "$(P)$(R)VRAMPinterval") {
    #^^above comments apply
    field(DESC, "Set ramp up interval") 
    field(HOPR, "1000000")
    field(EGU, "seconds")
    field(PINI, "YES")
}

record(ai, "$(P)$(R)VRAMPstepSize"){
    field(DESC, "Set voltage ramp step size")
    field(VAL, "$(VMIN)") 
    field(LOPR, "$(VMIN)")
    field(HOPR, "$(VMAX)")
    field(PINI, "YES")
}

record(bi, "$(P)$(R)VRAMPmode"){
    field(DESC, "Set ramp mode")
    field(PINI, "YES")
    field(VAL, "0") #Automatic mode by default
    #automatic means calculation is performed, manual means user sets step size and interval
    field(ZNAM, "Automatic")
    field(ONAM, "Manual")
}


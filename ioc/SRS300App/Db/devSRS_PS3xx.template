#______________________________________________
#__________Autoscale for data browser__________

#data browser doesn't allow for changing the y axis limits using rules
#so instead, autoscale is used and two pvs are plotted invisibly on the graph to control it
#the autoscale pvs are calculated differently depending on whether it is ramping or idle

#calculate y axis max and min for ramping
#calculated such that y axis shows between starting voltage and target voltage plus a small margin
record(calc, "$(DEVICE):YaxisMax"){
    field(DESC, "calc Y axis maximum")
    field(INPA, "$(DEVICE):desiredHV")
    field(INPB, "$(DEVICE):startVoltage")
    field(INPC, "$(DEVICE):C_minStepSize")
    field(CALC, "MAX(A,B)+C")

}
record(calc, "$(DEVICE):YaxisMin"){
    field(DESC, "calc Y axis minimum")
    field(INPA, "$(DEVICE):desiredHV")
    field(INPB, "$(DEVICE):startVoltage")
    field(INPC, "$(DEVICE):C_minStepSize")
    field(CALC, "MIN(A,B)-C")
}

#calculates y axis max and min for idle state
#calculated to show maximum 5000V on Y axis when idle plus a small margin
#for readability of graph when not ramping
record(calc, "$(DEVICE):idleYaxisMax"){
    field(DESC, "Set Y axis max when not ramping")
    field(INPA, "$(DEVICE):OutputVget")
    field(INPB, "$(DEVICE):C_minStepSize")
    field(CALC, "A + B")
}

record(calc, "$(DEVICE):idleYaxisMin"){
    field(DESC, "Set Y axis min when not ramping")
    field(INPA, "$(DEVICE):OutputVget")
    field(INPB, "$(DEVICE):C_minStepSize")
    field(INPC, "$(DEVICE):graphScale")
    field(CALC, "A>C ? A - C : 0")
}

record(ai, "$(DEVICE):graphScale"){
    field(DESC, "Margin for graph y axis when idle")
    field(VAL, "5000") #5000V margin by default
    field(EGU, "V")
    field(PINI, "YES")
}

#pvs to be plotted invisibly on the graph to control the autoscale feature in data browser
record(ai, "$(DEVICE):autoscaleControlMax"){
    field(DESC, "Control autoscale maximum")
    field(PINI, "YES")
}

record(ai, "$(DEVICE):autoscaleControlMin"){
    field(DESC, "Control autoscale minimum")
    field(PINI, "YES")
}

#sequences to set autoscale pvs to the calculated values
record(seq, "$(DEVICE):idleZoom"){
    field(DESC, "Auto zoom data browser")
    field(DOL1, "$(DEVICE):idleYaxisMax PP")
    field(LNK1, "$(DEVICE):autoscaleControlMax PP")
    field(DOL2, "$(DEVICE):idleYaxisMin PP")
    field(LNK2, "$(DEVICE):autoscaleControlMin PP")
    field(PINI, "YES")
}
record(seq, "$(DEVICE):rampZoom"){
    field(DESC, "Auto zoom data browser")
    field(DOL1, "$(DEVICE):YaxisMax")
    field(LNK1, "$(DEVICE):autoscaleControlMax PP")
    field(DOL2, "$(DEVICE):YaxisMin")
    field(LNK2, "$(DEVICE):autoscaleControlMin PP")
    
}

record(bi, "$(DEVICE):toolbarShow"){
    field(DESC, "Show/hide toolbar in ui")
    field(ZNAM, "Hide Toolbar")
    field(ONAM, "Show Toolbar")
    field(VAL, "0")
    field(PINI, "YES")
}


#_________________________________________
#__________ramp calculation_______________
record(aSub, "$(P)$(R)VRAMPcalc"){
    field(DESC, "Calculate ramp step size")
    field(SNAM, "rampcalc")
    #inputs
    field(INPA, "$(P)$(R)OutputVget")
    field(FTA, "DOUBLE")
    field(INPB, "$(P)$(R)desiredHV")
    field(FTB, "DOUBLE")
    field(INPC, "$(P)$(R)VRAMPtimeSet")
    field(FTC, "DOUBLE")
    field(INPD, "$(P)$(R)VRAMPstepSize")
    field(FTD, "DOUBLE")
    field(INPE, "$(P)$(R)VRAMPmode")
    field(FTE, "SHORT")
    field(INPF, "$(P)$(R)VRAMPinterval")
    field(FTF, "DOUBLE")
    field(INPG, "$(P)$(R)C_minStepSize")
    field(FTG, "DOUBLE")
    field(INPH, "$(P)$(R)C_minInterval")
    field(FTH, "DOUBLE")
    #outputs
    field(OUTA, "$(P)$(R)VRAMPstepSize PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(P)$(R)VRAMPinterval PP")
    field(FTVB, "DOUBLE")
    field(OUTC, "$(P)$(R)VRAMPactive PP")
    field(FTVC, "SHORT")

}

#_______________________________________
#_____________constants_________________
record(ai, "$(P)$(R)C_minStepSize"){
    field(DESC, "Minimum step size for automatic ramping")
    field(VAL, "$(VMIN)") 
    field(LOPR, "$(VMIN)")
    field(EGU, "V")
    field(PINI, "YES")
}

#the device needs approximately 1.45 seconds to stabilize voltage after setting before reading it again
#so the minimum interval between steps is set to 1.5 seconds to allow for this
#and the delay after setting voltage before reading back is set to 1.45 seconds
#so that it reads just after it has stabilised but before the next step is set
record(ai, "$(P)$(R)C_minInterval"){
    field(DESC, "Minimum interval between steps")
    field(VAL, "1.5") #1.5 second minimum to allow for voltage stabilizing and reading before setting new val
    field(EGU, "seconds")
    field(PINI, "YES")
    field(FLNK, "$(P)$(R)setOnStart")
}
record(ai, "$(P)$(R)C_vgetDelay"){
    field(DESC, "Delay before reading voltage")
    field(VAL, "1.45") #1.45 second minimum to allow for voltage stabilizing before reading
    field(EGU, "seconds")
    field(PINI, "YES")
}
record(ai, "$(P)$(R)C_Tolerance"){
    field(DESC, "Tolerance for ramping")
    field(PINI, "YES")
    field(VAL, "$(TOLERANCE)") #dependant on model
}
record(ai, "$(P)$(R)C_Precision"){
    field(DESC, "number of decimal places")
    field(PINI, "YES")
    field(VAL, "$(PREC)")
}
record(seq,"$(P)$(R)setOnStart"){
    #HOPR and LOPR can't take values from links and can only take doubles
    #So values must be passed in through sequence
    field(DESC, "sets values from constants")
    field(DOL1, "$(P)$(R)C_minInterval")
    field(LNK1, "$(P)$(R)VRAMPtimeSet.LOPR PP")
    field(DOL2, "$(P)$(R)C_minInterval")
    field(LNK2, "$(P)$(R)VRAMPinterval.LOPR PP")
    field(DOL3, "$(P)$(R)C_minInterval")
    field(LNK3, "$(P)$(R)VRAMPtimeSet PP")
    field(DOL4, "$(P)$(R)C_minInterval")
    field(LNK4, "$(P)$(R)VRAMPinterval PP")    
}
#_________________________________________
#__________ramp calculation_______________
record(aSub, "$(DEVICE):VRAMPcalc"){
    field(DESC, "Calculate ramp step size")
    field(SNAM, "rampcalc")
    #inputs
    field(INPA, "$(DEVICE):OutputVget")
    field(FTA, "DOUBLE")
    field(INPB, "$(DEVICE):desiredHV")
    field(FTB, "DOUBLE")
    field(INPC, "$(DEVICE):VRAMPtimeSet")
    field(FTC, "DOUBLE")
    field(INPD, "$(DEVICE):VRAMPstepSize")
    field(FTD, "DOUBLE")
    field(INPE, "$(DEVICE):VRAMPmode")
    field(FTE, "STRING")
    field(INPF, "$(DEVICE):VRAMPinterval")
    field(FTF, "DOUBLE")
    field(INPG, "$(DEVICE):C_minStepSize")
    field(FTG, "DOUBLE")
    field(INPH, "$(DEVICE):C_minInterval")
    field(FTH, "DOUBLE")
    #outputs
    field(OUTA, "$(DEVICE):VRAMPstepSize PP")
    field(FTVA, "DOUBLE")
    field(OUTB, "$(DEVICE):VRAMPinterval PP")
    field(FTVB, "DOUBLE")
    field(OUTC, "$(DEVICE):VRAMPactive PP")
    field(FTVC, "SHORT")
    field(OUTD, "$(DEVICE):E_smallStep PP")
    field(FTVD, "SHORT")
    field(OUTE, "$(DEVICE):VRAMPtimeSet PP")
    field(FTVE, "DOUBLE")

}

#_______________________________________
#_____________constants_________________
record(ai, "$(DEVICE):C_minStepSize"){
    field(DESC, "Minimum step size for automatic ramping")
    field(VAL, "$(VMIN)") 
    field(LOPR, "$(VMIN)")
    field(EGU, "V")
    field(PINI, "YES")
}

#the device needs approximately 1.45 seconds to stabilize voltage after setting before reading it again
#so the minimum interval between steps is set to 1.5 seconds to allow for this
#and the delay after setting voltage before reading back is set to 1.45 seconds
#so that it reads just after it has stabilised but before the next step is set
record(ai, "$(DEVICE):C_minInterval"){
    field(DESC, "Minimum interval between steps")
    field(VAL, "1.5") #1.5 second minimum to allow for voltage stabilizing and reading before setting new val
    field(EGU, "seconds")
    field(PINI, "YES")
    field(FLNK, "$(DEVICE):setOnStart")
}
record(ai, "$(DEVICE):C_vgetDelay"){
    field(DESC, "Delay before reading voltage")
    field(VAL, "1.45") #1.45 second minimum to allow for voltage stabilizing before reading
    field(EGU, "seconds")
    field(PINI, "YES")
}
record(ai, "$(DEVICE):C_Tolerance"){
    field(DESC, "Tolerance for ramping")
    field(PINI, "YES")
    field(VAL, "$(TOLERANCE)") #dependent on model
}
record(ai, "$(DEVICE):C_Precision"){
    field(DESC, "number of decimal places")
    field(PINI, "YES")
    field(VAL, "$(PREC)")
}

record(ai, "$(DEVICE):C_voltageLimit"){
    field(DESC, "Maximum voltage for device")
    field(PINI, "YES")
    field(HOPR, "$(VMAX)")
    field(VAL, "$(VMAX)") #dependent on model
    field(EGU, "V")
}

record(ai, "$(DEVICE):C_currentLimit"){
    field(DESC, "Maximum current for device")
    field(PINI, "YES")
    field(LOPR, "$(IMIN)")
    field(HOPR, "$(IMAX)")
    field(VAL, "$(IMAX)") #dependent on model
    field(EGU, "A")
}

record(ai, "$(DEVICE):C_currentTripLimit"){
    field(DESC, "Maximum current trip limit for device")
    field(VAL, "$(IMAX)") #dependent on model
    field(HOPR, "$(IMAX)")
    field(EGU, "A")
    field(PREC, "$(PREC)")
    
}

record(seq,"$(DEVICE):setOnStart"){
    #HOPR and LOPR can't take values from links and can only take doubles
    #So values must be passed in through sequence
    field(DESC, "sets values from constants")
    field(DOL1, "$(DEVICE):C_minInterval")
    field(LNK1, "$(DEVICE):VRAMPtimeSet.LOPR PP")
    field(DOL2, "$(DEVICE):C_minInterval")
    field(LNK2, "$(DEVICE):VRAMPinterval.LOPR PP")
    field(DOL3, "$(DEVICE):C_minInterval")
    field(LNK3, "$(DEVICE):VRAMPtimeSet PP")
    field(DOL4, "$(DEVICE):C_minInterval")
    field(LNK4, "$(DEVICE):VRAMPinterval PP")
}

#when changes are applied from the limit menu, set the device limits to the new values
record(seq,"$(DEVICE):setNewLimits"){
    field(DESC, "sets limits from constants")
    field(DOL1, "$(DEVICE):C_voltageLimit")
    field(LNK1, "$(DEVICE):VLIMset PP")
    field(DOL2, "$(DEVICE):C_currentLimit")
    field(LNK2, "$(DEVICE):ILIMset PP")
    field(DOL3, "$(DEVICE):C_currentTripLimit")
    field(LNK3, "$(DEVICE):ITRPset PP")
    field(DOL4, "$(DEVICE):C_voltageLimit")
    field(LNK4, "$(DEVICE):VRAMPstepSize.HOPR PP")
    field(DOL5, "$(DEVICE):C_voltageLimit")
    field(LNK5, "$(DEVICE):desiredHV.HOPR")
    field(DOL6, "$(DEVICE):C_voltageLimit")
    field(LNK6, "$(DEVICE):HVset.HOPR")
    field(DOL7, "$(DEVICE):C_voltageLimit")
    field(LNK7, "$(DEVICE):HVset.DRVH PP")
    field(DOL8, "$(DEVICE):C_voltageLimit")
    field(LNK8, "$(DEVICE):OutputVget.HOPR PP")
    field(DOL9, "$(DEVICE):C_voltageLimit")
    field(LNK9, "$(DEVICE):desiredHV.DRVH PP")

}

#If the menu is closed before changes are applied, limit values are changed back to what they were previously
record(seq, "$(DEVICE):limitMenuClosed"){
    field(DESC, "Sequence to run when limit menu closed")
    field(DOL1, "$(DEVICE):VLIMget PP")
    field(LNK1, "$(DEVICE):C_voltageLimit PP")
    field(DOL2, "$(DEVICE):ILIMget PP")
    field(LNK2, "$(DEVICE):C_currentLimit PP")
    field(DOL3, "$(DEVICE):ITRPget PP")
    field(LNK3, "$(DEVICE):C_currentTripLimit PP")
}

#If limits are reset to default from the menu, set device limits to default values
record(seq, "$(DEVICE):resetLimits"){
    field(DESC, "Reset limits to default from device")
    field(DO1, "$(VMAX)")
    field(LNK1, "$(DEVICE):C_voltageLimit PP")
    field(DO2, "$(IMAX)")
    field(LNK2, "$(DEVICE):C_currentLimit PP")
    field(DO3, "$(IMAX)")
    field(LNK3, "$(DEVICE):C_currentTripLimit PP")
    field(LNK4, "$(DEVICE):setNewLimits PP")
}

record(bi, "$(DEVICE):limitMenuOpen"){
    field(DESC, "Open/close limit menu (ui)")
    field(ZNAM, "Closed")
    field(ONAM, "Open")
    field(PINI, "YES")
}



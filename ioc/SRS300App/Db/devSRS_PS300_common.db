record(bo, "$(DEVICE):DISABLE")
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE=0)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}

#
# Aliases
#
alias("$(DEVICE):getESR","$(DEVICE):ESR")

alias("$(DEVICE):tripClear","$(DEVICE):CLEAR:SP")
alias("$(DEVICE):CLEAR:SP","$(DEVICE):CLEAR")

alias("$(DEVICE):enableHV","$(DEVICE):HV:SP")
alias("$(DEVICE):HV:SP","$(DEVICE):HV")

alias("$(DEVICE):voltageSet","$(DEVICE):VOLTAGE:SP")
alias("$(DEVICE):outputVoltageGet","$(DEVICE):VOLTAGE")
alias("$(DEVICE):VOLTAGE","$(DEVICE):SP:RBV")

alias("$(DEVICE):VLIMset","$(DEVICE):VOLTAGE:LIMIT:SP")
alias("$(DEVICE):VLIMget","$(DEVICE):VOLTAGE:LIMIT")
alias("$(DEVICE):VOLTAGE:LIMIT","$(DEVICE):VOLTAGE:LIMIT:SP:RBV")

alias("$(DEVICE):ILIMset","$(DEVICE):CURRENT:LIMIT:SP")
alias("$(DEVICE):ILIMget","$(DEVICE):CURRENT:LIMIT")
alias("$(DEVICE):CURRENT:LIMIT","$(DEVICE):CURRENT:LIMIT:SP:RBV")

alias("$(DEVICE):ITRPset","$(DEVICE):CURRENT:TRIP:LIMIT:SP")
alias("$(DEVICE):ITRPget","$(DEVICE):CURRENT:TRIP:LIMIT")
alias("$(DEVICE):CURRENT:TRIP:LIMIT","$(DEVICE):CURRENT:TRIP:LIMIT:SP:RBV")

alias("$(DEVICE):getSTB","$(DEVICE):STATUS")

alias("$(DEVICE):HVONstatus","$(DEVICE):HV:STATUS")

alias("$(DEVICE):ILIMstatus","$(DEVICE):CURRENT:LIMIT:STATUS")

alias("$(DEVICE):ITRIPstatus","$(DEVICE):CURRENT:TRIP:STATUS")

alias("$(DEVICE):VTRIPstatus","$(DEVICE):VOLTAGE:TRIP:STATUS")

alias("$(DEVICE):voltageStable","$(DEVICE):HV:STABLE:STATUS")

alias("$(DEVICE):outputCurrentGet","$(DEVICE):CURRENT")

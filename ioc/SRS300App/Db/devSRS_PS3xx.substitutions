file "$(TOP)/db/devSRS_PS3xx_sequences.template"
{
  #VMIN = Minimum voltage and minimum step size, VMAX = maximum voltage
  #IMIN and IMAX = Minimum and maximum current, respectively
  #POLARITY = Polarity of the device (for now, 0=positive 1 = negative)
  #TOLERANCE = Voltage amount the device may be inaccurate by at higher voltage levels.
  #PREC = decimal point accuracy of values
#all IMIN values are currently 0
#it is possible some devices may have negative current limits so these may need to be updated
    pattern { MODELNO, VMIN, VMAX, IMIN, IMAX, POLARITY, TOLERANCE}
            {"375", "100", "20000", "0", "525e-6", "0", "4" }
            { "370", "-20000", "-100", "0", "525e-6", "1", "10"}
            { "365", "100", "10000", "0", "1e-3", "0", "10"} 
            { "355", "-10000", "-100", "0", "1e-3", "1", "10"}
            { "350", "50", "5000", "0", "5.25e-3", "0", "10"}
            { "350", "-5000", "-50", "0", "5.25e-3", "1", "10"}
            { "325", "25", "2500", "0", "10.5e-3", "0", "10"}
            { "325", "-2500", "-25", "0", "10.5e-3",  "1", "10"}
            { "310", "12", "1250", "0",  "21e-3",  "0", "10"}
            { "310", "-1250", "-12", "0",  "21e-3",  "1", "10"}

}
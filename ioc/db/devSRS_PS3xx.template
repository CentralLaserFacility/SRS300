#
# Dummy record to trigger readbacks
#
record(seq, "$(P)$(R)ReadbackPoll_") {
    field(DESC, "Head of readback chain")
    field(PINI, "YES")
    field(SCAN, "1 second")
    field(LNK1, "$(P)$(R)getSTB.PROC")
    field(LNK2, "$(P)$(R)OutputVget.PROC")
    field(LNK3, "$(P)$(R)OutputIget.PROC")
}

record(mbbiDirect, "$(P)$(R)getSTB") {
    field(DESC, "SCPI get status byte")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getD(*STB) $(PORT) $(A)")
    field(FLNK, "$(P)$(R)HVONstatus")
    field(SIML, "$(P)$(R)SIM")
    field(SIOL, "$(P)$(R)SIM:STB")
}
record(bi, "$(P)$(R)HVONstatus") {
    field(DESC, "Is HV on?")
    field(INP,  "$(P)$(R)getSTB.B7 NPP MS")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P)$(R)ILIMstatus")
}
record(bi, "$(P)$(R)ILIMstatus") {
    field(DESC, "Is current limited?")
    field(INP,  "$(P)$(R)getSTB.B3 NPP MS")
    field(ZNAM, "No limit")
    field(ONAM, "Limited")
    field(FLNK, "$(P)$(R)ITRIPstatus")
}
record(bi, "$(P)$(R)ITRIPstatus") {
    field(DESC, "Tripped on overcurrent?")
    field(INP,  "$(P)$(R)getSTB.B2 NPP MS")
    field(ZNAM, "Not tripped")
    field(ONAM, "Tripped")
    field(FLNK, "$(P)$(R)VTRIPstatus")
}
record(bi, "$(P)$(R)VTRIPstatus") {
    field(DESC, "Tripped on overvoltage?")
    field(INP,  "$(P)$(R)getSTB.B1 NPP MS")
    field(ZNAM, "Not tripped")
    field(ONAM, "Tripped")
    field(FLNK, "$(P)$(R)HVSTABLEstatus")
}
record(bi, "$(P)$(R)HVSTABLEstatus") {
    field(DESC, "HV stable?")
    field(INP,  "$(P)$(R)getSTB.B0 NPP MS")
    field(ZNAM, "Unstable")
    field(ONAM, "Stable")
}
record(ai, "$(P)$(R)OutputVget") {
    field(DESC, "Output voltage readback")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(VOUT) $(PORT) $(A)")
    field(EGU,  "V")
    field(LOPR, "$(VMIN)")
    field(HOPR, "$(VMAX)")
    field(PREC, "4")
    field(SIML, "$(P)$(R)SIM")
    field(SIOL, "$(P)$(R)SIM:OutputVget")
}
record(ai, "$(P)$(R)OutputIget") {
    field(DESC, "Output current readback")
    field(DTYP, "stream")
    field(INP,  "@ps300.proto getF(IOUT) $(PORT) $(A)")
    field(EGU,  "A")
    field(LOPR, "0")
    field(HOPR, "500.0e-6")
    field(PREC, "4")
    field(SIML, "$(P)$(R)SIM")
    field(SIOL, "$(P)$(R)SIM:OutputIget")
}

#
# Ramp
#
record(ai, "$(P)$(R)VRAMPrun") {
    field(VAL, "0")
    field(FLNK, "$(P)$(R)VRAMPcycle")
}
record(ai, "$(P)$(R)VRAMPstart") {
    field(DESC, "Set commencing volts for ramp")
    field(EGU,  "V")
    field(VAL, "0")
    field(LOPR, "$(VMIN)")
    field(HOPR, "$(VMAX)")
    field(PREC, "3")
}
record(ai, "$(P)$(R)VRAMPend") {
    field(DESC, "Set ultimate voltage for ramp")
    #field(VAL, "VAL=$(VMAX)")
    field(VAL, "20000")
    field(EGU,  "V")
    field(LOPR, "$(VMIN)")
    field(HOPR, "$(VMAX)")
}
record(ai, "$(P)$(R)VRAMPinterval") {
    field(DESC, "Set voltage ramp up period")
    field(VAL, "1") #1 seconds
    field(LOPR, "1")
    field(HOPR, "60")
}
record(ai, "$(P)$(R)VRAMPincrement") {
    field(DESC, "Set voltage ramp up increment")
    field(VAL, "100")
    field(EGU,  "V")
}
record(calcout, "$(P)$(R)VRAMPcycle") {
    field(DESC, "Set output voltage limit")
    field(SCAN, "10 second")
    field(DISA, "$(P)$(R)VRAMPrun")
    field(INPA, "$(P)$(R)VRAMPcycle")
    field(INPB, "$(P)$(R)VRAMPend")
    #Need to key in $(P)$(R)VRAMPincrement but this is compile time perhaps a subsMacro?
    field(CALC, "A<B ? A+15 : 0")
    field(EGU,  "V")
    field(OOPT, "When Non-zero")
    field(LOPR, "$(VMIN)")
    field(HOPR, "$(VMAX)")    
    field(PREC, "3")
    field(OUT, "$(P)$(R)VLIMset")
}

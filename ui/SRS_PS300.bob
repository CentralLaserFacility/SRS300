          <action type="write_pv">
            <pv_name>$(pv_name)</pv_name>
            <value>0</value>
            <description>Edit device nickname</description>
          </action>
        </actions>
        <pv_name>loc://OpenEditMenu</pv_name>
        <text></text>
        <width>25</width>
        <height>25</height>
        <foreground_color>
          <color red="26" green="26" blue="26">
          </color>
        </foreground_color>
        <background_color>
          <color red="51" green="51" blue="51">
          </color>
        </background_color>
        <tooltip>$(actions)</tooltip>
      </widget>
      <widget type="picture" version="2.0.0">
        <name>Picture_1</name>
        <file>editIcon.png</file>
        <width>24</width>
        <height>24</height>
        <opacity>0.85</opacity>
      </widget>
    </widget>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_3</name>
    <text>Prefix: $(DEVICE)</text>
    <x>29</x>
    <y>28</y>
    <width>229</width>
    <height>18</height>
    <font>
      <font family="Eras Demi ITC" style="REGULAR" size="14.0">
      </font>
    </font>
    <background_color>
      <color red="0" green="0" blue="0">
      </color>
    </background_color>
    <rules>
      <rule name="New Rule" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0 == 1">
          <value>false</value>
        </exp>
        <pv_name>loc://OpenEditMenu</pv_name>
      </rule>
    </rules>
  </widget>
</display>

<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Stanford SRS375 control screen</name>
  <macros>
    <DEVICE>VUL-TEST-PS300-1</DEVICE>
    <CONFIG>ramp1</CONFIG>
  </macros>
  <width>744</width>
  <height>790</height>
  <background_color>
    <color name="Button_Background" red="210" green="210" blue="210">
    </color>
  </background_color>
  <actions>
    <action type="write_pv">
      <pv_name>$(DEVICE):VRAMPrun</pv_name>
      <value>0</value>
      <description>Write PV</description>
    </action>
  </actions>
  <grid_visible>false</grid_visible>
  <widget type="label" version="2.0.0">
    <name>EDM activeXTextClass</name>
    <text></text>
    <width>731</width>
    <height>27</height>
    <font>
      <font family="Eras Demi ITC" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="ActiveText" red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="48" red="0" green="0" blue="0">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(DEVICE):HVenable</pv_name>
        <value>1</value>
        <description>Enable high voltage</description>
      </action>
    </actions>
    <text>HV On</text>
    <x>571</x>
    <y>51</y>
    <width>72</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="179" green="230" blue="179">
            </color>
          </value>
        </exp>
        <pv_name>$(DEVICE):HVONstatus</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(DEVICE):HVenable</pv_name>
        <value>0</value>
        <description>Disable high voltage</description>
      </action>
    </actions>
    <text>HV Off</text>
    <x>657</x>
    <y>50</y>
    <width>68</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>
            <color red="255" green="128" blue="128">
            </color>
          </value>
        </exp>
        <pv_name>$(DEVICE):HVONstatus</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="group" version="3.0.0">
    <name>VRAMP settings</name>
    <x>22</x>
    <y>55</y>
    <width>296</width>
    <height>248</height>
    <style>3</style>
    <background_color>
      <color red="255" green="255" blue="255" alpha="0">
      </color>
    </background_color>
    <widget type="rectangle" version="2.0.0">
      <name>Rectangle</name>
      <y>14</y>
      <width>289</width>
      <height>188</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Header_Background" red="77" green="77" blue="77">
        </color>
      </line_color>
      <background_color>
        <color red="240" green="249" blue="255" alpha="125">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>VRAMP settings</name>
      <text>Voltage ramp settings</text>
      <x>11</x>
      <y>1</y>
      <width>160</width>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="16.0">
        </font>
      </font>
      <background_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </background_color>
      <transparent>false</transparent>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Target Voltage</name>
      <text>Target Voltage:</text>
      <x>36</x>
      <y>85</y>
      <width>112</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>interval</name>
      <text>Ramp interval:</text>
      <x>36</x>
      <y>141</y>
      <width>96</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ramp time</name>
      <text>Ramp time:</text>
      <x>36</x>
      <y>112</y>
      <width>83</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>txtStepIncrement</name>
      <text>Step size:</text>
      <x>36</x>
      <y>169</y>
      <width>87</width>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Start ramp</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
          <description>Start ramp</description>
        </action>
      </actions>
      <pv_name>$(DEVICE):StartCharge.PROC</pv_name>
      <text>Start ramp</text>
      <x>29</x>
      <y>212</y>
      <background_color>
        <color red="179" green="230" blue="179">
        </color>
      </background_color>
      <rules>
        <rule name="dont allow to press while ramping or HV disabled" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0==1 || pv1 == 0">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
          <pv_name>$(DEVICE):HVONstatus</pv_name>
        </rule>
        <rule name="button text" prop_id="text" out_exp="false">
          <exp bool_exp="pv0==1">
            <value>Ramping</value>
          </exp>
          <exp bool_exp="pv1 == 0">
            <value>HV disabled</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
          <pv_name>$(DEVICE):HVONstatus</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Halt ramp</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
          <description>Halt ramp</description>
        </action>
      </actions>
      <pv_name>$(DEVICE):RampActive</pv_name>
      <text>Halt ramp</text>
      <x>162</x>
      <y>212</y>
      <background_color>
        <color red="179" green="179" blue="179">
        </color>
      </background_color>
      <rules>
        <rule name="dont allow to press while ramping or HV disabled" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="choice" version="2.0.0">
      <name>Auto or manual</name>
      <pv_name>$(DEVICE):RampMode</pv_name>
      <x>55</x>
      <y>48</y>
      <width>190</width>
      <height>30</height>
      <selected_color>
        <color red="153" green="213" blue="153">
        </color>
      </selected_color>
      <items>
        <item>Automatic</item>
        <item>Manual</item>
      </items>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update DV</name>
      <pv_name>$(DEVICE):TargetHV</pv_name>
      <x>158</x>
      <y>86</y>
      <width>95</width>
      <height>18</height>
      <precision>2</precision>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_RT</name>
      <pv_name>$(DEVICE):RampDuration</pv_name>
      <x>158</x>
      <y>113</y>
      <width>95</width>
      <height>18</height>
      <precision>2</precision>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_Ri</name>
      <pv_name>$(DEVICE):RampInterval</pv_name>
      <x>158</x>
      <y>141</y>
      <width>95</width>
      <height>18</height>
      <precision>2</precision>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_SS</name>
      <pv_name>$(DEVICE):RampStepSize</pv_name>
      <x>158</x>
      <y>169</y>
      <width>95</width>
      <height>18</height>
      <precision>2</precision>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>Spinner DV</name>
      <pv_name>$(DEVICE):TargetHV</pv_name>
      <x>158</x>
      <y>86</y>
      <precision>2</precision>
      <show_units>true</show_units>
      <background_color>
        <color red="179" green="230" blue="230">
        </color>
      </background_color>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="New Rule" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==1">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
        </rule>
      </rules>
      <increment>100.0</increment>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>Spinner_RT</name>
      <pv_name>$(DEVICE):RampDuration</pv_name>
      <x>158</x>
      <y>113</y>
      <precision>2</precision>
      <show_units>true</show_units>
      <background_color>
        <color red="179" green="230" blue="230">
        </color>
      </background_color>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="Ramping visibility" prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==1 || pv1==1">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
          <pv_name>$(DEVICE):RampMode</pv_name>
        </rule>
      </rules>
      <maximum>1000000.0</maximum>
      <increment>0.5</increment>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>Spinner_Ri</name>
      <pv_name>$(DEVICE):RampInterval</pv_name>
      <x>158</x>
      <y>141</y>
      <precision>2</precision>
      <show_units>true</show_units>
      <background_color>
        <color red="179" green="230" blue="230">
        </color>
      </background_color>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="visibility " prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==1 || pv1== 0">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
          <pv_name>$(DEVICE):RampMode</pv_name>
        </rule>
      </rules>
      <maximum>1000000.0</maximum>
      <increment>0.5</increment>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>Spinner_SS</name>
      <pv_name>$(DEVICE):RampStepSize</pv_name>
      <x>158</x>
      <y>169</y>
      <show_units>true</show_units>
      <background_color>
        <color red="179" green="230" blue="230">
        </color>
      </background_color>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="visibility " prop_id="visible" out_exp="false">
          <exp bool_exp="pv0==1 || pv1== 0">
            <value>false</value>
          </exp>
          <pv_name>$(DEVICE):RampActive</pv_name>
          <pv_name>$(DEVICE):RampMode</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>

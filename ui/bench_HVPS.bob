  <widget type="multi_state_led" version="2.0.0">
    <name>LED (Multi State)_1</name>
    <pv_name>$(P)$(R)StableMultiState</pv_name>
    <x>128</x>
    <y>343</y>
    <width>18</width>
    <height>18</height>
    <rules>
      <rule name="while ramping allow for 1 second of instability" prop_id="states[1].color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="0" green="224" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)VRAMPactive</pv_name>
      </rule>
    </rules>
    <states>
      <state>
        <value>0</value>
        <label></label>
        <color>
          <color red="0" green="224" blue="60">
          </color>
        </color>
      </state>
      <state>
        <value>1</value>
        <label></label>
        <color>
          <color name="ActiveText" red="255" green="255" blue="0">
          </color>
        </color>
      </state>
      <state>
        <value>2</value>
        <label></label>
        <color>

      <rules>
        <rule name="New Rule" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="pv0 !=0">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(P)$(R)E_smallStep</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(P)$(R)HVenable</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>HV On</text>
      <x>315</x>
      <y>14</y>
      <width>85</width>
      <rules>
        <rule name="selected colour" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0==1">
            <value>
              <color red="179" green="230" blue="179">
              </color>
            </value>
          </exp>
          <pv_name>$(P)$(R)HVenable</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions>
        <action type="write_pv">
          <description>WritePV</description>
          <pv_name>$(P)$(R)HVenable</pv_name>
          <value>0</value>
        </action>
      </actions>
      <text>HV Off</text>
      <x>413</x>
      <y>14</y>
      <width>85</width>
      <rules>
        <rule name="selected colour" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0==0">
            <value>
              <color red="255" green="128" blue="128">
              </color>
            </value>
          </exp>
          <pv_name>$(P)$(R)HVenable</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label</name>
      <text>Output Voltage graph</text>
      <x>220</x>
      <y>269</y>
      <width>189</width>
      <height>32</height>
      <font>
        <font family="Lato Heavy" style="REGULAR" size="16.0">
        </font>
      </font>
    </widget>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_3</name>
    <text>Set current limit:</text>
    <x>780</x>
    <y>330</y>
    <width>120</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>Set voltage limit:</text>
    <x>780</x>
    <y>309</y>
    <width>120</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_13</name>
    <text>Set current trip limit:</text>
    <x>780</x>
    <y>350</y>
    <width>150</width>
  </widget>
  <widget type="spinner" version="2.0.0">
    <name>Spinner</name>
    <pv_name>$(P)$(R)C_voltageLimit</pv_name>
    <x>890</x>
    <y>310</y>
  </widget>
  <widget type="spinner" version="2.0.0">
    <name>Spinner_1</name>
    <pv_name>$(P)$(R)C_currentLimit</pv_name>
    <x>890</x>
    <y>330</y>
    <precision>4</precision>
    <show_units>true</show_units>
    <increment>1.0E-4</increment>
  </widget>
  <widget type="spinner" version="2.0.0">
    <name>Spinner_2</name>
    <pv_name>$(P)$(R)C_currentTripLimit</pv_name>
    <x>920</x>
    <y>350</y>
    <precision>4</precision>
    <show_units>true</show_units>
    <increment>1.0E-4</increment>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_4</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)setNewLimits.PROC</pv_name>
    <text>Apply</text>
    <x>770</x>
    <y>410</y>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_5</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)resetLimits.PROC</pv_name>
    <text>reset to default</text>
    <x>920</x>
    <y>410</y>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_6</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)limitMenuClosed.PROC</pv_name>
    <text>close menu</text>
    <x>780</x>
    <y>460</y>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_3</name>
    <pv_name>$(P)$(R)VLIMget</pv_name>
    <x>1120</x>
    <y>310</y>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_4</name>
    <pv_name>$(P)$(R)ILIMget</pv_name>
    <x>1120</x>
    <y>330</y>
    <precision>4</precision>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_5</name>
    <pv_name>$(P)$(R)ITRPget</pv_name>
    <x>1110</x>
    <y>350</y>
    <precision>4</precision>
  </widget>
</display>

  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
        <description>Write PV</description>
      </action>
    </actions>
    <pv_name>$(P)$(R)chargeStartHelper</pv_name>
    <text>Start ramp</text>
    <x>24</x>
    <y>233</y>
    <background_color>
      <color red="179" green="230" blue="179">
      </color>
    </background_color>
    <rules>
      <rule name="dont allow to press while ramping" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>false</value>
        </exp>
        <pv_name>$(P)$(R)VRAMPactive</pv_name>
      </rule>
      <rule name="ramping text" prop_id="text" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>Ramping</value>
        </exp>
        <pv_name>$(P)$(R)VRAMPactive</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>

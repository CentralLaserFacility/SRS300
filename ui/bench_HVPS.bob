    <widget type="action_button" version="3.0.0">
      <name>Start ramp</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>1</value>
          <description>Start ramp</description>
        </action>
      </actions>
      <pv_name>$(P)$(R)chargeStartHelper</pv_name>
      <text>Start ramp</text>
      <x>29</x>
      <y>212</y>
      <background_color>
        <color red="179" green="230" blue="179">
        </color>
      </background_color>
      <rules>
        <rule name="dont allow to press while ramping or HV disabled" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0==1 || pv1 == 0">
            <value>false</value>
          </exp>
          <pv_name>$(P)$(R)VRAMPactive</pv_name>
          <pv_name>$(P)$(R)HVONstatus</pv_name>
        </rule>
        <rule name="button text" prop_id="text" out_exp="false">
          <exp bool_exp="pv0==1">
            <value>Ramping</value>
          </exp>
          <exp bool_exp="pv1 == 0">
            <value>HV disabled</value>
          </exp>
          <pv_name>$(P)$(R)VRAMPactive</pv_name>
          <pv_name>$(P)$(R)HVONstatus</pv_name>
        </rule>
      </rules>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Abort</name>
      <actions>
        <action type="write_pv">
          <pv_name>$(pv_name)</pv_name>
          <value>0</value>
          <description>Write PV</description>
        </action>
      </actions>
      <pv_name>$(P)$(R)VRAMPactive</pv_name>
      <text>Halt ramp</text>
      <x>162</x>
      <y>212</y>
      <foreground_color>
        <color name="Header_ForeGround" red="255" green="255" blue="255">
        </color>
      </foreground_color>
      <background_color>
        <color red="153" green="153" blue="153">
        </color>
      </background_color>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="choice" version="2.0.0">
      <name>Auto or manual</name>

  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_2</name>
    <x>810</x>
    <y>460</y>
    <width>450</width>
    <rules>
      <rule name="Yminimum" prop_id="y_axes[0].minimum" out_exp="true">
        <exp bool_exp="True">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)YaxisMin</pv_name>
      </rule>
      <rule name="Ymaximum" prop_id="y_axes[0].maximum" out_exp="true">
        <exp bool_exp="True">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)YaxisMax</pv_name>
      </rule>
      <rule name="set X" prop_id="x_axis.maximum" out_exp="true">
        <exp bool_exp="True">
          <expression>((pv0)*5)+(pv1*5)</expression>
        </exp>
        <pv_name>$(P)$(R)VRAMPtimeSet</pv_name>
        <pv_name>$(P)$(R)VRAMPinterval</pv_name>
      </rule>
    </rules>
    <x_axis>
      <title>_</title>
      <autoscale>false</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>false</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>false</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Voltage</title>
        <autoscale>false</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>5000.0</maximum>
        <show_grid>false</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <x_pv>$(P)$(R)voltageGraphArray.TIME</x_pv>
        <y_pv>$(P)$(R)voltageGraphArray</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="tank" version="2.0.0">
    <name>Tank</name>
    <x>1220</x>
    <y>135</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="databrowser" version="2.0.0">
    <name>Data Browser_2</name>
    <file>voltageGraph.plt</file>
    <x>20</x>
    <y>460</y>
    <width>640</width>
    <rules>
      <rule name="show toolbar" prop_id="show_toolbar" out_exp="true">
        <exp bool_exp="True">
          <expression>pvInt0</expression>
        </exp>
        <pv_name>$(P)$(R)toolbarShow</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)idleZoom</pv_name>
    <text>Idle zoom</text>
    <x>680</x>
    <y>460</y>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)rampZoom</pv_name>
    <text>Ramp zoom</text>
    <x>680</x>
    <y>506</y>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_4</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)outZoom</pv_name>
    <text>Zoom out</text>
    <x>680</x>
    <y>552</y>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_1</name>
    <pv_name>$(P)$(R)toolbarShow</pv_name>
    <x>680</x>
    <y>600</y>
    <off_label>Show toolbar</off_label>
    <off_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </off_color>
    <on_label>Hide toolbar</on_label>
    <on_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </on_color>
    <show_led>false</show_led>
  </widget>
</display>

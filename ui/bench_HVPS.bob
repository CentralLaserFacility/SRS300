  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(P)$(R)errorMessage</pv_name>
    <x>419</x>
    <y>219</y>
    <width>182</width>
    <background_color>
      <color red="255" green="0" blue="0" alpha="0">
      </color>
    </background_color>
    <rules>
      <rule name="New Rule" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0 !=0">
          <value>
            <color name="STOP" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)E_smallStep</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)HVenable</pv_name>
        <value>1</value>
        <description>WritePV</description>
      </action>
    </actions>
    <text>HV On</text>
    <x>326</x>
    <y>60</y>
    <width>85</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="179" green="230" blue="179">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)HVenable</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)HVenable</pv_name>
        <value>0</value>
        <description>WritePV</description>
      </action>
    </actions>
    <text>HV Off</text>
    <x>424</x>
    <y>60</y>
    <width>85</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>
            <color red="153" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)HVenable</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Output Voltage graph</text>
    <x>238</x>
    <y>315</y>
    <width>194</width>
    <height>24</height>
    <font>
      <font family="Eras Bold ITC" style="REGULAR" size="16.0">
      </font>
    </font>
  </widget>
</display>

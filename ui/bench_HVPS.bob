  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>BENCH:HVPS:asyn.STAT</pv_name>
    <x>535</x>
    <y>2</y>
    <font>
      <font family="Eras Demi ITC" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

#Show the error message if a disconnect occurs & clear if STAT returns to OK
if PVUtil.getLong(pvs[1])== 0:
    widget.setPropertyValue('bit', 1)
    widget.setPropertyValue('tooltip', '')
else:
    widget.setPropertyValue('bit', 0)
    error = PVUtil.getStringArray(pvs[0])
    s = ''
    for i in error[0:100]:
        if int(i) != 0:
    	    s = s + chr(int(i))
    if len(s) > 0:
        widget.setPropertyValue('tooltip', s)






]]></text>
        <pv_name trigger="false">BENCH:HVPS:asyn.ERRS</pv_name>
        <pv_name>BENCH:HVPS:asyn.STAT</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)chargeStartHelper</pv_name>
    <text>Start ramp</text>
    <x>37</x>
    <y>252</y>
    <background_color>
      <color red="179" green="230" blue="179">
      </color>
    </background_color>
    <rules>
      <rule name="dont allow to press while ramping" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>false</value>
        </exp>
        <pv_name>$(P)$(R)VRAMPactive</pv_name>
      </rule>
      <rule name="ramping text" prop_id="text" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>Ramping</value>
        </exp>
        <pv_name>$(P)$(R)VRAMPactive</pv_name>
      </rule>
      <rule name="New Rule" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>false</value>
        </exp>
        <pv_name>$(P)$(R)HVONstatus</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>$(pv_name)</pv_name>
        <value>0</value>
      </action>
    </actions>
    <pv_name>$(P)$(R)VRAMPactive</pv_name>
    <text>Abort</text>
    <x>170</x>
    <y>252</y>
    <foreground_color>
      <color name="Header_ForeGround" red="255" green="255" blue="255">
      </color>
    </foreground_color>
    <background_color>
      <color name="STOP" red="255" green="0" blue="0">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>

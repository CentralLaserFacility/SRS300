<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Stanford SRS375 control screen</name>
  <macros>
    <P>BENCH:</P>
    <R>HVPS:</R>
    <CONFIG>ramp1</CONFIG>
  </macros>
  <width>1500</width>
  <height>1000</height>
  <background_color>
    <color name="Button_Background" red="210" green="210" blue="210">
    </color>
  </background_color>
  <actions>
    <action type="write_pv">
      <pv_name>$(P)$(R)VRAMPrun</pv_name>
      <value>0</value>
      <description>Write PV</description>
    </action>
  </actions>
  <grid_visible>false</grid_visible>
  <widget type="label" version="2.0.0">
    <name>EDM activeXTextClass</name>
    <text>Bench SR375 HVPS</text>
    <width>731</width>
    <height>25</height>
    <font>
      <font family="Eras Demi ITC" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="ActiveText" red="255" green="255" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="48" red="0" green="0" blue="0">
      </color>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="led" version="2.0.0">
    <name>LED</name>
    <pv_name>BENCH:HVPS:asyn.STAT</pv_name>
    <x>707</x>
    <y>2</y>
    <font>
      <font family="Eras Demi ITC" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

#Show the error message if a disconnect occurs & clear if STAT returns to OK
if PVUtil.getLong(pvs[1])== 0:
    widget.setPropertyValue('bit', 1)
    widget.setPropertyValue('tooltip', '')
else:
    widget.setPropertyValue('bit', 0)
    error = PVUtil.getStringArray(pvs[0])
    s = ''
    for i in error[0:100]:
        if int(i) != 0:
    	    s = s + chr(int(i))
    if len(s) > 0:
        widget.setPropertyValue('tooltip', s)






]]></text>
        <pv_name trigger="false">BENCH:HVPS:asyn.ERRS</pv_name>
        <pv_name>BENCH:HVPS:asyn.STAT</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)HVenable</pv_name>
        <value>1</value>
        <description>WritePV</description>
      </action>
    </actions>
    <text>HV On</text>
    <x>571</x>
    <y>51</y>
    <width>72</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color red="179" green="230" blue="179">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)HVONstatus</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)$(R)HVenable</pv_name>
        <value>0</value>
        <description>WritePV</description>
      </action>
    </actions>
    <text>HV Off</text>
    <x>657</x>
    <y>50</y>
    <width>68</width>
    <rules>
      <rule name="selected colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>
            <color red="255" green="128" blue="128">
            </color>
          </value>
        </exp>
        <pv_name>$(P)$(R)HVONstatus</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
